# ==============================================================================
# Sworders SOC - Backend Environment Configuration Example
# ==============================================================================
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/sworders_soc

APP_NAME=Sworders SOC API
APP_ENV=development
API_PREFIX=/api

# Demo safety nets
DEMO_DB_FALLBACK=true
SEED_DEMO_DATA=true

# Authentication — set a long random value in any shared deployment (never commit it)
SECRET_KEY=
DEMO_USER_EMAIL=analyst@sworders.demo
DEMO_USER_PASSWORD=SwordersDemo2026

# Azure OpenAI Configuration (Reserved for Phase 4 / AI Summary Service)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
